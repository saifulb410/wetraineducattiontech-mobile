{
  "expo": {
    "name": "WeTrainEducation",
    "slug": "wetraineducattiontech",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wetraineducattiontech.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1628"
      },
      "package": "com.wetraineducattiontech.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wetraineducattiontech.vercel.app",
              "pathPrefix": "/auth"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "wetrainedu"
  }
}
